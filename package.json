{
  "name": "modelclash",
  "version": "1.0.0",
  "description": "modelclash — compare responses from OpenAI, Anthropic, and Google models side-by-side",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "modelclash": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["cli", "openai", "anthropic", "google", "gemini", "llm", "ai"],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "@google/genai": "^0.7.0",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "openai": "^4.73.0",
    "ora": "^8.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  }
}

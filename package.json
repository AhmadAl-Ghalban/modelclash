{
  "name": "modelclash-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "modelclash — compare responses from OpenAI, Anthropic, and Google models side-by-side",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @modelclash/core && npm run build -w modelclash",
    "dev": "npm run dev --workspace @modelclash/cli",
    "start": "npm run start --workspace @modelclash/cli",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf packages/*/dist"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}

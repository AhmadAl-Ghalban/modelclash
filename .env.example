# ── CLI / legacy env vars (still used by CLI tool) ──────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...
GROQ_API_KEY=gsk_...
DEEPSEEK_API_KEY=sk-...
# Ollama runs locally; set its base URL to enable it. Default: http://localhost:11434/v1
# Ollama needs no API key and is enabled by default at the URL below.
# Only set this if your daemon runs somewhere else.
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional overrides
DEFAULT_OPENAI_MODEL=gpt-5.6-terra
DEFAULT_ANTHROPIC_MODEL=claude-opus-5
DEFAULT_GOOGLE_MODEL=gemini-3.7-flash
DEFAULT_GROQ_MODEL=llama-3.3-70b-versatile
DEFAULT_DEEPSEEK_MODEL=deepseek-v4-flash
DEFAULT_OLLAMA_MODEL=llama3.2

# Optional request timeout in milliseconds
REQUEST_TIMEOUT_MS=60000

# ── NestJS server (packages/server) ─────────────────────────────────────────
# Port 5433 is what docker-compose publishes (container 5432), so this works
# for a natively-run server. Inside Docker the server overrides it with 5432.
DATABASE_URL=postgresql://modelclash:modelclash@localhost:5433/modelclash
PORT=3001
FRONTEND_URL=http://localhost:3000

# ── Nuxt frontend (packages/web) ─────────────────────────────────────────────
NUXT_PUBLIC_API_BASE=http://localhost:3001/api

# ── Docker Compose overrides ─────────────────────────────────────────────────
# OLLAMA_MODELS=llama3.2 qwen2.5    # space-separated models to pull
# API_BASE=http://server:3001/api   # internal API URL when web runs in Docker
